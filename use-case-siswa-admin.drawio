                <mxCell id="guide_box_petugas" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#0f172a;spacing=14;" value="&lt;b style=&#39;font-size:16px;color:#0f172a;&#39;&gt;📋 URAIAN ALUR PROSES KERJA — ROLE PETUGAS TU (VERIFIKATOR &amp;amp; PENGESAH)&lt;/b&gt;&lt;hr&gt;&lt;ol style=&#39;font-size:12.5px;line-height:1.8;color:#1e293b;padding-left:20px;margin:0;&#39;&gt;&lt;li&gt;&lt;b style=&#39;color:#6d28d9;&#39;&gt;Autentikasi Petugas&lt;/b&gt;: Petugas TU membuka website SIPESAT dan melakukan login ke panel khusus Staf TU.&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#475569;&#39;&gt;Penyajian Dashboard TU&lt;/b&gt;: Sistem memvalidasi kredensial peran Admin/TU dan menyajikan ringkasan statistik persuratan.&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#6d28d9;&#39;&gt;Membuka Antrean Masuk&lt;/b&gt;: Petugas mengakses menu &lt;i&gt;&#39;Antrean Surat Masuk&#39;&lt;/i&gt; untuk melihat permohonan baru dari siswa.&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#475569;&#39;&gt;Pengambilan Data Kueri&lt;/b&gt;: Sistem mengambil seluruh permohonan yang berstatus &lt;b&gt;DIAJUKAN&lt;/b&gt; dari basis data dan menampilkannya dalam tabel terurut waktu.&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#6d28d9;&#39;&gt;Pratinjau Berkas&lt;/b&gt;: Petugas memilih salah satu permohonan siswa. Sistem memuat pratinjau (preview) dokumen pendukung yang diunggah siswa.&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#6d28d9;&#39;&gt;Pemeriksaan Keabsahan Dokumen&lt;/b&gt;: Petugas memeriksa kelayakan, kejelasan visual, dan keaslian berkas persyaratan.&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#dc2626;&#39;&gt;Skenario Penolakan / Permintaan Revisi&lt;/b&gt;:&lt;br&gt;&amp;bull; Jika berkas tidak sesuai/buram, Petugas mengisi alasan penolakan pada kolom feedback dan menekan &lt;i&gt;&#39;Tolak &amp;amp; Minta Revisi&#39;&lt;/i&gt;.&lt;br&gt;&amp;bull; Sistem mengubah status menjadi &lt;b&gt;DITOLAK&lt;/b&gt; dan otomatis mengirimkan pemberitahuan revisi ke akun siswa.&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#15803d;&#39;&gt;Skenario Persetujuan (Approval)&lt;/b&gt;:&lt;br&gt;&amp;bull; Jika berkas telah sah dan lengkap, Petugas memasukkan nomor agenda surat masuk TU.&lt;br&gt;&amp;bull; Petugas menekan tombol &lt;i&gt;&#39;Setujui / Approve Permohonan&#39;&lt;/i&gt;.&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#475569;&#39;&gt;Penerbitan Dokumen Digital Sistem&lt;/b&gt;:&lt;br&gt;&amp;bull; Sistem secara otomatis men-generate nomor surat resmi sekolah sesuai pola baku (&lt;i&gt;421.3/XXX/SMK-PSKD3/X/2026&lt;/i&gt;).&lt;br&gt;&amp;bull; Sistem membuat QR Code tanda tangan digital terenkripsi yang memuat token validasi dokumen.&lt;br&gt;&amp;bull; Sistem mengompilasi kop surat resmi sekolah, biodata siswa, nomor surat, dan QR Code ke dalam format PDF resmi, lalu memperbarui status menjadi &lt;b&gt;SELESAI&lt;/b&gt; serta mengirimkan notifikasi ke siswa.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Selesai&lt;/b&gt;: Alur kerja verifikasi dan pengesahan surat oleh Petugas TU selesai tuntas.&lt;/li&gt;&lt;/ol&gt;" vertex="1">
                    <mxGeometry height="1120" width="910" x="890" y="110" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="act-siswa-petugas" name="2C. Activity Diagram Terpadu (Siswa s.d Petugas)">
        <mxGraphModel dx="2065" dy="1833" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1450" math="0" shadow="0">
            <root>
