                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="guide_box_siswa" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#0f172a;spacing=14;" value="&lt;b style=&#39;font-size:16px;color:#0f172a;&#39;&gt;📋 URAIAN ALUR PROSES KERJA — ROLE SISWA (PEMOHON)&lt;/b&gt;&lt;hr&gt;&lt;ol style=&#39;font-size:12.5px;line-height:1.8;color:#1e293b;padding-left:20px;margin:0;&#39;&gt;&lt;li&gt;&lt;b style=&#39;color:#0369a1;&#39;&gt;Inisiasi Login&lt;/b&gt;: Siswa membuka website SIPESAT dan memasukkan NISN serta kata sandi terdaftar.&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#475569;&#39;&gt;Validasi Akun Sistem&lt;/b&gt;: Sistem memeriksa kredensial siswa via JWT; jika valid, sistem menampilkan antarmuka Dashboard Siswa.&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#0369a1;&#39;&gt;Akses Layanan&lt;/b&gt;: Siswa memilih menu &lt;i&gt;&#39;Pengajuan Surat&#39;&lt;/i&gt; pada navigasi aplikasi.&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#475569;&#39;&gt;Penyajian Formulir&lt;/b&gt;: Sistem memuat katalog master jenis surat (Aktif Sekolah, Rekomendasi, Izin, Mutasi) beserta daftar persyaratan dokumen.&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#0369a1;&#39;&gt;Pengisian Data &amp;amp; Upload&lt;/b&gt;: Siswa memilih jenis surat, mengisi keterangan keperluan pengajuan, dan mengunggah berkas lampiran (PDF/JPG maksimal 2 MB).&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#0369a1;&#39;&gt;Pengiriman Berkas&lt;/b&gt;: Siswa menekan tombol &lt;i&gt;&#39;Kirim Permohonan&#39;&lt;/i&gt;.&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#475569;&#39;&gt;Validasi Berkas Sistem&lt;/b&gt;: Sistem memeriksa form dan ukuran file:&lt;br&gt;&amp;bull; &lt;span style=&#39;color:#dc2626;&#39;&gt;&lt;b&gt;Jika Tidak Valid&lt;/b&gt;: Sistem memunculkan alert peringatan, siswa wajib memperbaiki isian/file.&lt;/span&gt;&lt;br&gt;&amp;bull; &lt;span style=&#39;color:#16a34a;&#39;&gt;&lt;b&gt;Jika Valid&lt;/b&gt;: Sistem menyimpan data ke database dengan status awal &lt;b&gt;DIAJUKAN&lt;/b&gt;, menerbitkan resi kode tiket unik, dan meneruskan permohonan ke meja Petugas TU.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#0369a1;&#39;&gt;Pemantauan Real-Time&lt;/b&gt;: Siswa memantau status surat melalui stepper tracker. Jika ada catatan penolakan dari TU, siswa menerima feedback koreksi dan dapat mengunggah ulang berkas.&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#15803d;&#39;&gt;Pengunduhan Surat Resmi&lt;/b&gt;: Setelah status berubah menjadi &lt;b&gt;SELESAI&lt;/b&gt;, siswa mengklik &lt;i&gt;&#39;Unduh Surat PDF&#39;&lt;/i&gt;. Sistem mengalirkan file digital ber-Kop Surat dan QR Code validasi ke perangkat siswa.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Selesai&lt;/b&gt;: Alur kerja pengajuan surat oleh peran Siswa selesai tuntas.&lt;/li&gt;&lt;/ol&gt;" vertex="1">
                    <mxGeometry height="1120" width="920" x="880" y="110" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
