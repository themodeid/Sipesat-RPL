                <mxCell id="e_p_app5" edge="1" parent="1" source="p_act_btn_app" style="endArrow=classic;html=1;strokeColor=#334155;strokeWidth=2;" target="p_end_app">
                    <mxGeometry relative="1" as="geometry"/>
