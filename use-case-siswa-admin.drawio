                </mxCell>
                <mxCell id="flow_guide_box_c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#0f172a;spacing=14;" value="&lt;b style=&#39;font-size:16px;color:#0f172a;&#39;&gt;📋 URAIAN ALUR PROSES KERJA TERPADU (DARI SISWA SAMPAI PETUGAS)&lt;/b&gt;&lt;hr&gt;&lt;ol style=&#39;font-size:12.5px;line-height:1.75;color:#1e293b;padding-left:20px;margin:0;&#39;&gt;&lt;li&gt;&lt;b style=&#39;color:#0369a1;&#39;&gt;Inisiasi Siswa&lt;/b&gt;: Siswa membuka website SIPESAT dan login menggunakan NISN &amp;amp; kata sandi.&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#0369a1;&#39;&gt;Pemilihan Layanan&lt;/b&gt;: Siswa memilih jenis surat yang dibutuhkan (Surat Aktif Sekolah, Rekomendasi, Izin/Dispensasi, Pindah Sekolah).&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#0369a1;&#39;&gt;Pengisian &amp;amp; Unggah Berkas&lt;/b&gt;: Siswa mengisi alasan keperluan dan wajib mengunggah file persyaratan (PDF/JPG maks 2MB).&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#0369a1;&#39;&gt;Pengiriman&lt;/b&gt;: Siswa menekan tombol &lt;i&gt;&#39;Kirim Permohonan&#39;&lt;/i&gt;.&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#475569;&#39;&gt;Validasi Sistem&lt;/b&gt;: Sistem memeriksa kelengkapan form dan ukuran berkas:&lt;br&gt;&amp;bull; &lt;span style=&#39;color:#dc2626;&#39;&gt;&lt;b&gt;Jika Tidak Valid&lt;/b&gt;: Sistem menampilkan pesan peringatan dan meminta siswa mengoreksi unggahan.&lt;/span&gt;&lt;br&gt;&amp;bull; &lt;span style=&#39;color:#16a34a;&#39;&gt;&lt;b&gt;Jika Valid&lt;/b&gt;: Sistem menyimpan data ke database dengan status &lt;b&gt;DIAJUKAN&lt;/b&gt;, menerbitkan resi tiket, dan meneruskan permohonan ke meja Petugas.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#6d28d9;&#39;&gt;Pemeriksaan Petugas&lt;/b&gt;: Petugas TU login ke panel admin, membuka antrean surat masuk, dan meninjau keabsahan berkas permohonan.&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#6d28d9;&#39;&gt;Keputusan Petugas&lt;/b&gt;:&lt;br&gt;&amp;bull; &lt;span style=&#39;color:#dc2626;&#39;&gt;&lt;b&gt;Jika Ditolak&lt;/b&gt;: Petugas mengisi catatan revisi dan menekan &lt;i&gt;&#39;Tolak &amp;amp; Minta Revisi&#39;&lt;/i&gt;. Sistem meng-update status menjadi &lt;b&gt;DITOLAK&lt;/b&gt; dan mengirim notifikasi koreksi ke siswa agar memperbaiki berkas.&lt;/span&gt;&lt;br&gt;&amp;bull; &lt;span style=&#39;color:#16a34a;&#39;&gt;&lt;b&gt;Jika Disetujui&lt;/b&gt;: Petugas memasukkan nomor agenda masuk dan menekan &lt;i&gt;&#39;Setujui / Approve&#39;&lt;/i&gt;.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#475569;&#39;&gt;Penerbitan Digital Sistem&lt;/b&gt;: Sistem secara otomatis men-generate nomor surat resmi sekolah dan membuat QR Code validasi tanda tangan digital.&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#475569;&#39;&gt;Kompilasi Dokumen&lt;/b&gt;: Sistem menggabungkan kop resmi sekolah, identitas siswa, dan QR Code ke dalam dokumen PDF resmi, lalu mengubah status menjadi &lt;b&gt;SELESAI&lt;/b&gt;.&lt;/li&gt;&lt;li&gt;&lt;b style=&#39;color:#0369a1;&#39;&gt;Unduh Berkas Resmi&lt;/b&gt;: Siswa menerima notifikasi bahwa surat telah siap dan dapat mengunduh atau mencetak berkas PDF resmi ber-QR Code.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Selesai&lt;/b&gt;: Alur operasional persuratan selesai tuntas.&lt;/li&gt;&lt;/ol&gt;" vertex="1">
                    <mxGeometry height="1260" width="830" x="1230" y="115" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="usecase-siswa-admin" name="3. Use Case Diagram (Siswa &amp; Petugas)">
        <mxGraphModel dx="1715" dy="1521" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1200" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="header_banner" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#38bdf8;fontColor=#f8fafc;align=center;verticalAlign=middle;strokeWidth=2;" value="&lt;b style=&#39;font-size:18px;&#39;&gt;🏛️ USE CASE DIAGRAM — SISTEM INFORMASI PENGAJUAN SURAT SISWA (SIPESAT)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:12px;color:#94a3b8;&#39;&gt;Format Standar Bahan Ajar RPL UNINDRA (Pertemuan 04): 2 Role Eksklusif (Siswa &amp;amp; Petugas TU/Admin)&lt;/span&gt;" vertex="1">
