                <mxCell id="ec_s_finish" edge="1" parent="1" source="sc_act_ok" style="endArrow=classic;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;labelBackgroundColor=#ffffff" target="sc_end">
