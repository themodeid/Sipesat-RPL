                <mxCell id="seq1_pill" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=13" value="&lt;b&gt;1. SEQUENCE DIAGRAM LOGIN (Pola BCE Slide 18-20)&lt;/b&gt;" vertex="1">
                    <mxGeometry height="36" width="1020" x="40" y="100" as="geometry" />
                </mxCell>
                <mxCell id="seq1_act_icon" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11" value="&lt;b&gt;Pengguna&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#000000;'&gt;(Siswa/Petugas)&lt;/span&gt;" vertex="1">
