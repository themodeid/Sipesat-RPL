    <diagram id="srs-context-sipesat" name="Bab 2.1 - Diagram Konteks &amp; Arsitektur Produk">
        <mxGraphModel dx="1314" dy="662" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="hdr_banner" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;strokeWidth=2;" value="&lt;b style=&#39;font-size:16px;&#39;&gt;DIAGRAM KONTEKS &amp;amp; PERSPEKTIF ARSITEKTUR PRODUK (SIPESAT)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:12px;color:#000000;&#39;&gt;Dokumen Spesifikasi Kebutuhan Perangkat Lunak (SRS) Standar IEEE Std 830-1998 / Karl Wiegers — Kelompok 7 (RPL_XD)&lt;/span&gt;" vertex="1">
