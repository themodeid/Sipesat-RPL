                </mxCell>
                <mxCell id="box_siswa" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;align=center;verticalAlign=middle;" value="&lt;b style=&#39;font-size:13px;&#39;&gt;Aktor: Siswa (Aktor Pemohon)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:11px;&#39;&gt;Perangkat: Smartphone / Web Browser&lt;br&gt;Protokol: HTTPS (Port 443)&lt;/span&gt;" vertex="1">
                    <mxGeometry height="75" width="360" x="150" y="115" as="geometry"/>
                </mxCell>
                <mxCell id="box_tu" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;align=center;verticalAlign=middle;" value="&lt;b style=&#39;font-size:13px;&#39;&gt;Aktor: Petugas TU &amp;amp; Kepala Sekolah&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:11px;&#39;&gt;Perangkat: Desktop PC / Web Browser&lt;br&gt;Protokol: HTTPS (Port 443)&lt;/span&gt;" vertex="1">
                    <mxGeometry height="75" width="360" x="890" y="115" as="geometry"/>
                </mxCell>
                <mxCell id="box_app_boundary" parent="1" style="swimlane;startSize=32;fontStyle=1;align=center;verticalAlign=top;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=13;" value="Boundary: Aplikasi Web SIPESAT (Next.js 15 App Router)" vertex="1">
                    <mxGeometry height="340" width="1100" x="150" y="240" as="geometry"/>
                </mxCell>
                <mxCell id="mod_presentation" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;align=center;verticalAlign=middle;" value="&lt;b&gt;Presentation Layer (UI/UX)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:11px;&#39;&gt;• Tailwind CSS &amp;amp; Pure Neutral Zinc&lt;br&gt;• React Server &amp;amp; Client Components&lt;br&gt;• Real-time Status Stepper Tracker&lt;/span&gt;" vertex="1">
                    <mxGeometry height="95" width="480" x="180" y="295" as="geometry"/>
                </mxCell>
                <mxCell id="mod_security" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;align=center;verticalAlign=middle;" value="&lt;b&gt;Security &amp;amp; Session Management&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:11px;&#39;&gt;• JSON Web Token (JWT) HttpOnly Cookie&lt;br&gt;• Role-Based Access Control (RBAC Guard)&lt;br&gt;• Password Hash Verification (Argon2 / Bcrypt)&lt;/span&gt;" vertex="1">
                    <mxGeometry height="95" width="480" x="730" y="295" as="geometry"/>
                </mxCell>
                <mxCell id="mod_business" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;align=center;verticalAlign=middle;" value="&lt;b&gt;Business Logic &amp;amp; Validation Engine&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:11px;&#39;&gt;• Runtime Schema Validation (Zod Boundary Guard)&lt;br&gt;• Service Layer Persuratan &amp;amp; Disposisi TU&lt;br&gt;• State Transition Machine Validator&lt;/span&gt;" vertex="1">
                    <mxGeometry height="95" width="480" x="180" y="445" as="geometry"/>
                </mxCell>
                <mxCell id="mod_document" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;align=center;verticalAlign=middle;" value="&lt;b&gt;Document &amp;amp; QR Engine&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:11px;&#39;&gt;• PDFKit Official Letterhead Compiler&lt;br&gt;• Dynamic QR Code TTE Hash Generator&lt;br&gt;• Public Document Verification Resolver&lt;/span&gt;" vertex="1">
                    <mxGeometry height="95" width="480" x="730" y="445" as="geometry"/>
                </mxCell>
                <mxCell id="box_db" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;align=center;verticalAlign=middle;" value="&lt;b style=&#39;font-size:13px;&#39;&gt;Basis Data: PostgreSQL 16&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:11px;&#39;&gt;• Master Data Siswa, Akun, &amp;amp; Jenis Surat&lt;br&gt;• tb_pengajuan_surat &amp;amp; Riwayat Status&lt;br&gt;• Immutable Audit Log &amp;amp; Disposisi TU&lt;/span&gt;" vertex="1">
                    <mxGeometry height="110" width="440" x="200" y="640" as="geometry"/>
