# ==============================================================================
# .gitignore — SIPESAT WEB (Kelompok 7 RPL UNINDRA)
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables & Secrets (Guardrail: Dilarang bocor ke publik)
.env
.env.*
!.env.example
*.env
*.env.local
*.pem
*.key

# Next.js Build Outputs & Cache
.next/
*/.next/
out/
build/
dist/
.vercel
*.tsbuildinfo
next-env.d.ts

# Testing & Coverage
coverage/
*/coverage/

# Uploaded Files & Temporary Dynamic Content
be/uploads/*
!be/uploads/.gitkeep

# System & Editor Junk
.DS_Store
Thumbs.db
ehthumbs.db
.vscode/
.idea/

# Backup & Scratch Files
*.bak
scratch/
